#include <stdio.h>
#include <ctype.h>

int main()
{
    char s[]="BM";
    char m[5][5]={
    {'p','l','a','y','f'},
    {'i','r','e','x','m'},
    {'b','c','d','g','h'},
    {'k','n','o','q','s'},
    {'t','u','v','w','z'}};

    int i,j,r1=0,c1=0,r2=0,c2=0;

    s[0]=tolower(s[0]);
    s[1]=tolower(s[1]);

    for(i=0;i<5;i++)
    for(j=0;j<5;j++)
    {
        if(m[i][j]==s[0])
        {
            r1=i;
            c1=j;
        }

        if(m[i][j]==s[1])
        {
            r2=i;
            c2=j;
        }
    }

    if(r1==r2)
        printf("%c%c",
        m[r1][(c1+4)%5],
        m[r2][(c2+4)%5]);

    else if(c1==c2)
        printf("%c%c",
        m[(r1+4)%5][c1],
        m[(r2+4)%5][c2]);

    else
        printf("%c%c",
        m[r1][c2],
        m[r2][c1]);

    return 0;
}
