#include <stdio.h>
int main()
{
    char s[]="hi";
    char m[5][5]={
    {'p','l','a','y','f'},
    {'i','r','e','x','m'},
    {'b','c','d','g','h'},
    {'k','n','o','q','s'},
    {'t','u','v','w','z'}};

    int i,j,r1,c1,r2,c2;

    for(i=0;s[i];i+=2)
    {
        for(r1=0;r1<5;r1++)
        for(c1=0;c1<5;c1++)
            if(m[r1][c1]==s[i])
                goto first;
        first:
        for(r2=0;r2<5;r2++)
        for(c2=0;c2<5;c2++)
            if(m[r2][c2]==s[i+1])
                goto second;
        second:

        if(r1==r2)
            printf("%c%c",m[r1][(c1+1)%5],
                         m[r2][(c2+1)%5]);
        else if(c1==c2)
            printf("%c%c",m[(r1+1)%5][c1],
                         m[(r2+1)%5][c2]);
        else
            printf("%c%c",m[r1][c2],m[r2][c1]);
    }
    return 0;
}
