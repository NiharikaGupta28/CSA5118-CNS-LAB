#include <stdio.h>
int main()
{
    char s[]="bqq";
    int a,b,i;

    for(a=1;a<26;a+=2)
    {
        for(b=0;b<26;b++)
        {
            printf("a=%d b=%d : ",a,b);

            for(i=0;s[i];i++)
                printf("%c",
                ((s[i]-'a'-b+26)*a)%26+'a');

            printf("\n");
        }
    }
    return 0;
}
