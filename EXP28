#include <stdio.h>

int main() {
    int q = 23, g = 5;
    int a = 6, b = 15;
    int A = 1, B = 1, key1 = 1, key2 = 1;

    for(int i = 0; i < a; i++) A = (A * g) % q;
    for(int i = 0; i < b; i++) B = (B * g) % q;

    for(int i = 0; i < a; i++) key1 = (key1 * B) % q;
    for(int i = 0; i < b; i++) key2 = (key2 * A) % q;

    printf("Alice key = %d\n", key1);
    printf("Bob key = %d", key2);

    return 0;
}
